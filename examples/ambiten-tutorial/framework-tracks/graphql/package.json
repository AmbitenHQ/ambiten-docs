{
  "name": "ambiten-framework-track-graphql",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev:apollo": "tsx watch src/apollo.ts",
    "dev:yoga": "tsx watch src/yoga.ts",
