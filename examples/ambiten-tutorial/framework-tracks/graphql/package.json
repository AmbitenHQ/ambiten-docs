    "@apollo/server": "^5.5.1",
    "@graphql-tools/schema": "10.0.23",
    "dotenv": "^16.4.7",
    "graphql": "^16.0.0",
    "graphql-yoga": "^5.24.1",
    "mongodb": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
